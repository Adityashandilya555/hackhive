  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#Crop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Crop</rdfs:label>
    <rdfs:comment xml:lang="en">A kind of crop grown on a field (e.g. paddy rice), not an individual plant.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#IE1">
    <rdf:type rdf:resource="http://example.org/smartfarm#IrrigationEvent"/>
    <rdfs:label xml:lang="en">Irrigation of Field C after critical reading</rdfs:label>
    <sf:irrigates rdf:resource="http://example.org/smartfarm#FieldC"/>
    <sosa:madeByActuator rdf:resource="http://example.org/smartfarm#DR1"/>
