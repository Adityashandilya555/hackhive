  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#LowMoistureObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n9066ed71e89a49a2a9396821cf3b29dcb26"/>
    <rdfs:label xml:lang="en">Low-moisture observation</rdfs:label>
    <rdfs:comment xml:lang="en">Volumetric soil moisture below 30 %: too dry for water-intensive crops.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#ObsD1">
