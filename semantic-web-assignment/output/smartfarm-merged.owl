    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:label xml:lang="en">Weather station</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#FieldD">
