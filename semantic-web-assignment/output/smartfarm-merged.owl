  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#hasSoilType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/smartfarm#Field"/>
