    <rdf:rest rdf:nodeID="n9066ed71e89a49a2a9396821cf3b29dcb14"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/smartfarm#ObsW1">
    <rdf:type rdf:resource="http://example.org/smartfarm#WeatherObservation"/>
    <sosa:madeBySensor rdf:resource="http://example.org/smartfarm#WS1"/>
    <sosa:observedProperty rdf:resource="http://example.org/smartfarm#AirTemperature"/>
    <sosa:hasFeatureOfInterest rdf:resource="http://example.org/smartfarm#NandiValleyFarm"/>
    <sf:airTemperatureC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">31.4</sf:airTemperatureC>
    <sosa:resultTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-12T14:00:00+05:30</sosa:resultTime>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has sample</rdfs:label>
    <skos:definition xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</skos:definition>
    <rdfs:comment xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
    <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isSampleOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
