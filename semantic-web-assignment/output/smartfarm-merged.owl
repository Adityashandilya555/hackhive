    <sf:soilMoisturePercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">41.0</sf:soilMoisturePercent>
    <sosa:resultTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-12T06:00:00+05:30</sosa:resultTime>
  </rdf:Description>
