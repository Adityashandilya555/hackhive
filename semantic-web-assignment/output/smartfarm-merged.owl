  <rdf:Description rdf:about="http://example.org/smartfarm#IrrigationSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
    <rdfs:label xml:lang="en">Irrigation system</rdfs:label>
    <rdfs:comment xml:lang="en">Equipment that applies water to a field. Modelled as a SOSA actuator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">phenomenon time</rdfs:label>
    <skos:definition xml:lang="en">The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity.</skos:definition>
    <rdfs:comment xml:lang="en">The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity.</rdfs:comment>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
