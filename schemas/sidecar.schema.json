{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "k_found": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K Found"
        },
        "k_lb": {
          "title": "K Lb",
          "type": "integer"
        },
        "proof": {
          "default": "none",
          "enum": [
            "exhaustive",
            "lb_met",
            "greedy",
            "none"
          ],
          "title": "Proof",
          "type": "string"
        }
      },
      "required": [
        "k_lb"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "description": "Every tunable limit. The defaults are the organisers' problem statement.",
      "properties": {
        "cost_weights": {
          "$ref": "#/$defs/CostWeights",
          "default": {
            "bend": 0.5,
            "cross": 5.0,
            "length": 1.0,
            "overlap": 1.0
          }
        },
        "flip_y": {
          "default": false,
          "title": "Flip Y",
          "type": "boolean"
        },
        "grid_m": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "title": "Grid M",
          "type": "number"
        },
        "hub_wall_clearance_m": {
          "default": 0.5,
          "minimum": 0,
          "title": "Hub Wall Clearance M",
          "type": "number"
        },
        "interior_windows_as_doors": {
          "default": false,
          "title": "Interior Windows As Doors",
          "type": "boolean"
        },
        "is_problem_statement": {
          "description": "True only for the organisers' preset. Written to the JSON (#30: a WHAT-IF sidecar says\n`false`), never read from it: it's recomputed from the settings on every load.",
          "readOnly": true,
          "title": "Is Problem Statement",
          "type": "boolean"
        },
        "max_area_m2": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Max Area M2",
          "type": "number"
        },
        "max_nodes": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Max Nodes",
          "type": "integer"
        },
        "origin_shift": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin Shift",
          "type": "array"
        },
        "route_through_other_rooms": {
          "default": false,
          "title": "Route Through Other Rooms",
          "type": "boolean"
        },
        "tolerance_m": {
          "default": 0.001,
          "exclusiveMinimum": 0,
          "title": "Tolerance M",
          "type": "number"
        },
        "zone_links_via_excluded": {
          "default": false,
          "title": "Zone Links Via Excluded",
          "type": "boolean"
        }
      },
      "required": [
        "is_problem_statement"
      ],
      "title": "Constraints",
      "type": "object"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "properties": {
        "B": {
          "title": "B",
          "type": "integer"
        },
        "H": {
          "title": "H",
          "type": "integer"
        },
        "J": {
          "title": "J",
          "type": "number"
        },
        "L": {
          "title": "L",
          "type": "number"
        },
        "O": {
          "title": "O",
          "type": "number"
        },
        "X": {
          "title": "X",
          "type": "integer"
        },
        "area_gap": {
          "title": "Area Gap",
          "type": "number"
        }
      },
      "required": [
        "H",
        "L",
        "X",
        "O",
        "B",
        "J",
        "area_gap"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "CostWeights": {
      "description": "Weights of J = length·L + cross·X + overlap·O + bend·B.",
      "properties": {
        "bend": {
          "title": "Bend",
          "type": "number"
        },
        "cross": {
          "title": "Cross",
          "type": "number"
        },
        "length": {
          "title": "Length",
          "type": "number"
        },
        "overlap": {
          "title": "Overlap",
          "type": "number"
        }
      },
      "required": [
        "length",
        "cross",
        "overlap",
        "bend"
      ],
      "title": "CostWeights",
      "type": "object"
    },
    "FoldedPart": {
      "additionalProperties": false,
      "properties": {
        "area_m2": {
          "title": "Area M2",
          "type": "number"
        },
        "into_room_id": {
          "title": "Into Room Id",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        }
      },
      "required": [
        "room_id",
        "into_room_id",
        "area_m2"
      ],
      "title": "FoldedPart",
      "type": "object"
    },
    "HubMetrics": {
      "additionalProperties": false,
      "description": "One hub's share of the metrics, for the per-hub summary (#17, #44). Slide 8 has no room.",
      "properties": {
        "B": {
          "title": "B",
          "type": "integer"
        },
        "L": {
          "title": "L",
          "type": "number"
        },
        "O": {
          "title": "O",
          "type": "number"
        },
        "X": {
          "title": "X",
          "type": "integer"
        },
        "area_m2": {
          "title": "Area M2",
          "type": "number"
        },
        "hub_id": {
          "title": "Hub Id",
          "type": "string"
        },
        "n_nodes": {
          "title": "N Nodes",
          "type": "integer"
        }
      },
      "required": [
        "hub_id",
        "area_m2",
        "n_nodes",
        "L",
        "X",
        "O",
        "B"
      ],
      "title": "HubMetrics",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "input_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Digest"
        },
        "input_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Path"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "properties": {
        "hub_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hub Id"
        },
        "ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "error",
            "strict"
          ],
          "title": "Severity",
          "type": "string"
        },
        "where": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Where",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "severity",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything that is not part of the submission.",
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bounds"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostBreakdown"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "folded_parts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FoldedPart"
      },
      "title": "Folded Parts",
      "type": "array"
    },
    "frame": {
      "anyOf": [
        {
          "enum": [
            "identity",
            "flip_y",
            "origin_shift"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame"
    },
    "hubs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HubMetrics"
      },
      "title": "Hubs",
      "type": "array"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "default": {
        "input_digest": null,
        "input_path": null,
        "version": null
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "settings": {
      "$ref": "#/$defs/Constraints",
      "default": {
        "cost_weights": {
          "bend": 0.5,
          "cross": 5.0,
          "length": 1.0,
          "overlap": 1.0
        },
        "flip_y": false,
        "grid_m": 0.1,
        "hub_wall_clearance_m": 0.5,
        "interior_windows_as_doors": false,
        "is_problem_statement": true,
        "max_area_m2": 100.0,
        "max_nodes": 5,
        "origin_shift": [
          0.0,
          0.0
        ],
        "route_through_other_rooms": false,
        "tolerance_m": 0.001,
        "zone_links_via_excluded": false
      }
    },
    "status": {
      "enum": [
        "ok",
        "submitted_strict_only",
        "infeasible",
        "input_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "violations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Violation"
      },
      "title": "Violations",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "status"
  ],
  "title": "Sidecar",
  "type": "object"
}
